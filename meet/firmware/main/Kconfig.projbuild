menu "Gotchi Meet"

    config GOTCHI_MEET_SERVER_URL
        string "Meet server URL"
        default "https://gotchi-meet.vercel.app"
        help
            Base URL of the server in meet/server, without a trailing slash.

    config GOTCHI_MEET_DEVICE_SECRET
        string "Device secret"
        default ""
        help
            Must match DEVICE_SECRET on the meet server. Keep it in
            secrets.defaults, which git ignores.

    # Names shared with call/firmware, whose board and media code reads them.
    config GOTCHI_CALL_SPEAKER_VOLUME
        int "Default speaker volume (0-100)"
        default 70
        range 0 100

    config GOTCHI_CALL_MIC_GAIN_DB
        int "Microphone gain (dB)"
        default 30
        range 0 37

endmenu
